<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delta Seafood</title>

  <style>
    body {
      background-color: white;
      margin: 0;
      font-family: Arial, sans-serif;
      text-align: center;
    }

    .logo {
      width: 300px;
      margin-top: 30px;
      margin-bottom: 50px;
      cursor: pointer;
    }

    .gallery {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 40px;
      padding: 20px;
    }

    .image-box {
      width: 250px;
    }

    .image-box img {
      width: 100%;
      border-radius: 10px;
    }

    .filename {
      margin-top: 10px;
      font-size: 18px;
      font-weight: bold;
    }
  </style>
</head>
<body>

  <!-- Main Logo -->
  <a href="index.html">
    <img src="Búmerki.png" alt="Logo" class="logo">
  </a>

  <!-- Image Gallery -->
  <div class="gallery">

    <div class="image-box">
      <img src="toskur.png" alt="Toskur">
      <div class="filename">toskur.png</div>
    </div>

    <div class="image-box">
      <img src="Hýsa.png" alt="Hýsa">
      <div class="filename">Hýsa.png</div>
    </div>

    <div class="image-box">
      <img src="Upsi.png" alt="Upsi">
      <div class="filename">Upsi.png</div>
    </div>

  </div>

</body>
</html>